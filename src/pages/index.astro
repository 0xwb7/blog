---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";

import { getCollection } from "astro:content";

const posts = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft
  )
)
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() -
      a.data.pubDate.getTime()
  )
  .slice(0, 4);
---

<BaseLayout>

  <section class="py-16">

    <h1
      class="max-w-2xl text-4xl font-bold leading-tight tracking-tight md:text-5xl"
    >
      0xwb7
    </h1>

    <p
      class="mt-6 max-w-xl leading-8 text-secondary"
    >
      &nbsp 안녕하세요. 이우빈입니다. <br />
      &nbsp 공부하고 경험한 것들을 기록하는 곳입니다.
    </p>

  </section>

  <section class="mt-10">

    <div
      class="flex items-center justify-between border-b border-outline pb-4"
    >

      <h2 class="text-xl font-bold">
        Recent Posts
      </h2>

      <a
        href="/posts"
        class="text-sm text-muted hover:text-foreground"
      >
        모든 글 보기 →
      </a>

    </div>

    <div
      class="divide-y divide-outline"
    >

      {
        posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            tags={post.data.tags}
            href={`/posts/${post.id}`}
          />
        ))
      }

    </div>

  </section>

</BaseLayout>
