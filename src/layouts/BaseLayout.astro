---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "0xwb7_blog",
  description = "개발 공부와 프로젝트 기록",
} = Astro.props;
---

<!doctype html>
<html lang="ko">

  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <meta
      name="description"
      content={description}
    />

    <title>{title}</title>
  </head>

  <body>

    <Header />

    <main class="mx-auto max-w-4xl px-6 py-12">
      <slot />
    </main>

  </body>

</html>
