---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags: string[];
  href: string;
}

const {
  title,
  description,
  pubDate,
  category,
  tags,
  href,
} = Astro.props;
---

<article class="py-7">

  <a
    href={href}
    class="group block"
  >

    <div
      class="mb-2 flex items-center gap-2 text-sm"
    >

      <span
        class="font-medium text-zinc-700"
      >
        {category}
      </span>

      <span class="text-zinc-300">
        ·
      </span>

      <time datetime={pubDate.toISOString()} class="text-zinc-500">
        {
          pubDate.toLocaleDateString("ko-KR", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>

    </div>

    <h2
      class="text-xl font-semibold transition group-hover:text-zinc-500"
    >
      {title}
    </h2>

    <p
      class="mt-2 leading-7 text-zinc-600"
    >
      {description}
    </p>

    <div
      class="mt-4 flex flex-wrap gap-2"
    >

      {
        tags.map((tag) => (
          <span
            class="rounded-md bg-zinc-100 px-2.5 py-1 text-xs text-zinc-600"
          >
            #{tag}
          </span>
        ))
      }

    </div>

  </a>

</article>
